<div class="custom-blog-list">
  <% for (const item of items) { %>
    <div class="blog-item">
      <!-- 1. Title (Bold, matches body font) -->
      <h3 class="blog-title">
        <a href="<%= item.path %>"><%= item.title %></a>
      </h3>

      <!-- 2. Description (Same body font) -->
      <% if (item.description) { %>
        <p class="blog-desc"><%= item.description %></p>
      <% } %>

      <!-- 3. Date (Grayish & close to description) -->
      <% if (item.date) { %>
        <span class="blog-date"><%= item.date %></span>
      <% } %>
    </div>
  <% } %>
</div>
