<div class="custom-blog-list">
  <% for (const item of items) { %>
    <div class="blog-item">
      <!-- 1. Title -->
      <h3 class="blog-title">
        <a href="<%- item.path %>"><%- item.title %></a>
      </h3>

      <!-- 2. Description -->
      <% if (item.description) { %>
        <p class="blog-desc"><%- item.description %></p>
      <% } %>

      <!-- 3. Date -->
      <% if (item.date) { %>
        <span class="blog-date"><%- item.date %></span>
      <% } %>
    </div>
  <% } %>
</div>
